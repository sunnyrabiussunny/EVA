# AI Provider: ollama (offline) or claude
AI_PROVIDER=ollama

# Ollama model — must match: ollama list
OLLAMA_MODEL=llama3.1:latest

# Ollama URL from inside Docker container
OLLAMA_URL=http://host.docker.internal:11434

# Optional Claude API key (leave blank for full offline)
ANTHROPIC_API_KEY=

# Data directory inside container
DATA_DIR=/app/data
