# ─── AI Provider ─────────────────────────────────────────
# Use "ollama" for fully offline (recommended)
# Use "claude" if you have an Anthropic API key
AI_PROVIDER=ollama

# Ollama model to use (must be pulled on your server)
# Run: ollama pull llama3.1
OLLAMA_MODEL=llama3.1:latest

# Ollama URL (default: host machine from Docker container)
OLLAMA_URL=http://host.docker.internal:11434

# ─── Optional: External AI API Keys ──────────────────────
# Leave blank to use Ollama offline mode
ANTHROPIC_API_KEY=

# ─── Data ────────────────────────────────────────────────
# Where SQLite DB and knowledge files are stored
DATA_DIR=/app/data
